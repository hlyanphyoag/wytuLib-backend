generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  password     String
  firstName    String
  lastName     String
  role         UserRole  @default(STUDENT)
  studentId    String?   @unique
  phone        String?
  address      String?
  dateOfBirth  DateTime?
  registeredAt DateTime  @default(now())
  isActive     Boolean   @default(true)
  refreshToken String?
  verifiedBy   String?
  isVerified   Boolean   @default(false)
  borrows      Borrow[]
  fines        Fine[]
  reviews      Review[]

  @@index([email])
  @@index([studentId])
  @@index([role])
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  books       Book[]
}

model Author {
  id        String       @id @default(cuid())
  name      String
  biography String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  books     BookAuthor[]

  @@index([name])
}

model Book {
  id              String       @id @default(cuid())
  isbn            String       @unique
  title           String
  subtitle        String?
  description     String?
  edition         String?
  pages           Int?
  coverImage      String?
  totalCopies     Int          @default(1)
  availableCopies Int          @default(1)
  status          BookStatus   @default(AVAILABLE)
  viewCount       Int          @default(0)
  borrowCount     Int          @default(0)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  categoryId      String
  downloadLink    String?
  coverColor      String?
  category        Category     @relation(fields: [categoryId], references: [id])
  authors         BookAuthor[]
  bookViews       BookView[]
  borrows         Borrow[]
  reviews         Review[]

  @@index([isbn])
  @@index([title])
  @@index([categoryId])
  @@index([status])
}

model BookAuthor {
  id       String @id @default(cuid())
  bookId   String
  authorId String
  author   Author @relation(fields: [authorId], references: [id], onDelete: Cascade)
  book     Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([bookId, authorId])
  @@index([bookId])
  @@index([authorId])
}

model Borrow {
  id              String       @id @default(cuid())
  borrowDate      DateTime     @default(now())
  dueDate         DateTime
  returnDate      DateTime?
  status          BorrowStatus @default(ACTIVE)
  renewalCount    Int          @default(0)
  notes           String?
  userId          String
  bookId          String
  returnedById    String?
  overdueNotified Boolean?     @default(false)
  book            Book         @relation(fields: [bookId], references: [id])
  user            User         @relation(fields: [userId], references: [id])
  fines           Fine[]

  @@index([userId])
  @@index([bookId])
  @@index([status])
  @@index([dueDate])
}

model Fine {
  id         String    @id @default(cuid())
  amount     Float
  reason     String
  isPaid     Boolean   @default(false)
  issuedDate DateTime  @default(now())
  paidDate   DateTime?
  issuedById String?
  userId     String
  borrowId   String?
  borrow     Borrow?   @relation(fields: [borrowId], references: [id])
  user       User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([isPaid])
  @@index([borrowId])
}

model Review {
  id             String   @id @default(cuid())
  rating         Int?
  comment        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  userId         String
  bookId         String
  parentReviewId String?
  book           Book     @relation(fields: [bookId], references: [id])
  user           User     @relation(fields: [userId], references: [id])
  parentReview   Review?  @relation("ReviewReplies", fields: [parentReviewId], references: [id])
  subReviews     Review[] @relation("ReviewReplies")

  @@unique([userId, bookId])
  @@index([bookId])
  @@index([rating])
}

model ActivityLog {
  id          String   @id @default(cuid())
  action      String
  description String
  userId      String?
  librarianId String
  createdAt   DateTime @default(now())

  @@index([librarianId])
  @@index([userId])
  @@index([createdAt])
}

model BookView {
  id        String   @id @default(cuid())
  viewedAt  DateTime @default(now())
  ipAddress String?
  userAgent String?
  bookId    String
  userId    String?
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([bookId])
  @@index([userId])
  @@index([viewedAt])
}

model TrendingBook {
  id             String   @id @default(cuid())
  bookId         String   @unique
  trendingScore  Float
  weeklyViews    Int      @default(0)
  weeklyBorrows  Int      @default(0)
  weeklyReviews  Int      @default(0)
  averageRating  Float?
  rank           Int
  lastCalculated DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([trendingScore])
  @@index([rank])
  @@index([lastCalculated])
}

enum UserRole {
  STUDENT
  ADMIN
}

enum BookStatus {
  AVAILABLE
  BORROWED
}

enum BorrowStatus {
  ACTIVE
  RETURNED
  OVERDUE
  LOST
}
